# Copy this file to .env and fill in the keys you have. Restart ui.py after changing it.

# The live database (same one the Next.js site reads/writes). Same values as
# viraasat-site/.env.local. If unset, falls back to a local viraasat.db file
# (VG_DB), which is what the test suite uses.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Google Cloud: enable "Places API (New)" for the key's project and turn on billing.
GOOGLE_MAPS_API_KEY=
# Optional: short summaries of Instagram captions.
ANTHROPIC_API_KEY=
